# environments, secrets
card_scanning_env/
.venv/
.env

# images (large; contain real ID cards): never commit
data/*
!data/rectified/
data/rectified/*
!data/rectified/alignment_log.csv

# real ID cards stay local (src/common/privacy.py): only the 8 specimen cards' ground truth is shared, the
# full-text tables live in private/, and OCR text dumps are never shared
ground_truth/*
!ground_truth/B01.txt
!ground_truth/B02.txt
!ground_truth/B03.txt
!ground_truth/F01.txt
!ground_truth/F02.txt
!ground_truth/F03.txt
!ground_truth/F04.txt
!ground_truth/F05.txt
private/
results/**/ocr_text/

# method outputs: only the small tables are shared (image pairs and splits, frame homographies)
out/*
!out/*.csv
results/ocr_cache/
logs/
*.log

# weights; the small training logs next to them are shared
checkpoints/**
!checkpoints/**/
!checkpoints/**/*.csv
!checkpoints/**/run.json
*.pt
*.pth
*.ckpt

# third-party code + pretrained weights (see README for download)
third_party/

# the ICASSP 2027 author kit (report/ has the style files it needs; the kit is public)
docs/course/icassp2027_template/

# archives (the submission zip, downloaded datasets)
*.zip
*.tar
*.tar.gz

# LaTeX build files (the .tex, .bib and final PDFs are kept)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz

# python / OS / editors / office lock files
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
.vscode/
.idea/
.claude/settings.local.json
~$*
